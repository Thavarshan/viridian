NODE_ENV=production
LOG_LEVEL=info
APP_KEY=replace-with-openssl-rand-hex-32
APP_DOMAIN=app.example.com
WIRE_IMAGE=ghcr.io/owner/wire:bootstrap

DB_USER=wire
DB_PASSWORD=replace-with-a-long-random-hex-secret
DB_DATABASE=wire

SESSION_DRIVER=cookie

MAIL_MAILER=smtp
MAIL_FROM_NAME=Wire
MAIL_FROM_ADDRESS=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
