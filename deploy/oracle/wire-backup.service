[Unit]
Description=Create and upload a PostgreSQL backup for Wire
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/wire
EnvironmentFile=-/etc/wire-backup.env
ExecStart=/opt/wire/backup-postgres.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/wire/backups
