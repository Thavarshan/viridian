{
  "extends": [
    "@adonisjs/tsconfig/tsconfig.client.json",
    "../../../tsconfig.base.json"
  ],
  "compilerOptions": {
    "module": "ESNext",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"],
      "~/*": ["./*"],
      "@generated/*": ["../.adonisjs/client/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../app/types/**/*.ts",
    "../.adonisjs/client/**/*.ts",
    "../.adonisjs/server/**/*.ts"
  ]
}
